{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,

    /* React Config */
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "skipLibCheck": true,
    "paths": {
      "react": ["./node_modules/react/compat/"],
      "react-dom": ["./node_modules/react/compat/"]
    }
  },
  "include": ["node_modules/vite/client.d.ts", "**/*"]
}
